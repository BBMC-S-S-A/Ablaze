# Copiar a .env y rellenar. El .env real nunca se sube: está en .gitignore.

NODE_ENV=development
PORT=3000

# Postgres en Railway. Sin esto la API arranca igual, sin persistencia,
# y /health lo reporta como "sin configurar".
DATABASE_URL=postgresql://usuario:clave@host:5432/ablaze

# El origen de la PWA. En producción la API solo acepta peticiones de aquí.
# NO se cambia nunca: OPFS está atado al origen y mudar de dominio borra la
# base local de quien tenga la aplicación instalada.
ORIGEN_DE_LA_APP=https://ablaze.hytrex.co
