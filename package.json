{
  "name": "ablaze",
  "private": true,
  "version": "0.0.0",
  "description": "Ablaze — registro de entrenamiento que conoce tu semana y tu gimnasio.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "app": "npm run start --workspace @ablaze/app",
    "app:web": "npm run web --workspace @ablaze/app",
    "api": "npm run dev --workspace @ablaze/api",
    "db:generate": "npm run generate --workspace @ablaze/db",
    "db:migrate": "npm run migrate --workspace @ablaze/db",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
